# Copy to .env (never commit .env). docker-compose.yml overrides DATABASE_URL for the web container.
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://sukidle:sukidle@localhost:5432/sukidle
REDIS_URL=
APP_NAME=Sukidle
# smmarkets.ph store code; "default" = the site's default store view (no Store header)
REFERENCE_BRANCH_CODE=default
# Kill switch for all scrapers
INGEST_ENABLED=false
# Required to scrape: goes in the honest User-Agent
SCRAPE_CONTACT_EMAIL=
AWS_REGION=ap-southeast-1
S3_BUCKET=
CDN_BASE_URL=
